# WhatsApp user data (PII) and downloaded media — never commit
data/users/*
!data/users/.gitkeep
data/uploads/*
!data/uploads/.gitkeep
data/users_migrated_to_db_*/
data/users_backup_*/

# Onboarding candidate log (may contain PII) and service account key
data/onboarding_log.csv
data/service_account.json

# Vector embeddings cache (regenerated from knowledge.md on startup)
*.vec.npz

# knowledge.md / knowledge_pre_join.md / knowledge_post_join.md are generated
