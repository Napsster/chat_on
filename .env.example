# Local Development Configuration
# Copy this to .env and fill in your values

# Environment mode — informational only, just changes a log line. Paths for
# uploads/db/knowledge always resolve under wherever this repo is checked out
# (override with PROJECT_DIR below if that's ever not what you want).
IS_LOCAL=true
# PROJECT_DIR=/absolute/path/to/this/checkout

# Server settings
HOST=0.0.0.0
PORT=8002

# DeepSeek (required for /whatsapp to generate real replies)
DEEPSEEK_API_KEY=

# JWT signing secret for the upload interface's login tokens. The code falls
# back to a placeholder string if unset — fine for local dev, NOT for
# production (anyone who knows the placeholder can forge valid tokens).
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Optional: encrypts chatbot.db at rest with SQLCipher (requires the
# sqlcipher3-binary package from requirements.txt). Leave unset for a plain
# unencrypted SQLite db (fine for local/test). If set, this exact value is
# needed to ever open the db again — losing it means losing the data.
# Generate one with: python3 -c "import secrets; print(secrets.token_hex(32))"
# DB_ENCRYPTION_KEY=

# Which WhatsApp provider /whatsapp speaks: "twilio" (default) or "meta"
# (direct WhatsApp Cloud API, no Twilio/WATI in between). Only the vars for
# the selected provider need to be filled in — the other provider's code
# just stays dormant.
WHATSAPP_PROVIDER=twilio

# Twilio (required for /whatsapp in production when WHATSAPP_PROVIDER=twilio;
# optional locally)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+14155238886

# Outreach: HR-initiated welcome/update messages from the upload interface's
# Outreach tab (optional — the tab works, but sends fail with a clear error
# until these are set). TWILIO_WHATSAPP_NUMBER defaults to TWILIO_PHONE_NUMBER
# if unset. TWILIO_WELCOME_TEMPLATE_SID is a WhatsApp message template
# approved via Twilio/Meta — required to message a candidate who has never
# messaged the bot (WhatsApp's 24h session-window rule; no way around this
# in code). The welcome send passes {"1": first_name} as the template's
# first variable — match your approved template's placeholder numbering.
# TWILIO_WHATSAPP_NUMBER=
# TWILIO_WELCOME_TEMPLATE_SID=

# Meta WhatsApp Cloud API (required for /whatsapp when WHATSAPP_PROVIDER=meta)
# Get these from developers.facebook.com (create an App -> add the WhatsApp
# product) and business.facebook.com/wa/manage (WhatsApp Manager, once your
# number is registered there):
#   META_ACCESS_TOKEN      — a PERMANENT token from a System User (Business
#                            Settings -> System Users), not the 24h token the
#                            App dashboard's Quick Start page shows by
#                            default — that one expires and sends will start
#                            failing silently a day after you deploy.
#   META_PHONE_NUMBER_ID   — WhatsApp Manager -> Phone numbers -> the number
#                            you registered -> "Phone number ID" (not the
#                            phone number itself).
#   META_APP_SECRET        — App dashboard -> Settings -> Basic -> App Secret.
#                            Used to verify inbound webhooks are really from
#                            Meta; leave unset only for local testing.
#   META_VERIFY_TOKEN      — any random string you invent; enter the same
#                            value in the App dashboard's Webhooks setup —
#                            Meta echoes it back during the one-time GET
#                            verification handshake against this server's
#                            /whatsapp endpoint.
# Webhook URL to enter in the dashboard: https://<your-domain>/whatsapp
# Subscribe to the "messages" webhook field.
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_APP_SECRET=
# META_VERIFY_TOKEN=

# Outreach welcome template for the Meta provider (optional, same 24h-window
# rule as Twilio's — a template lets you reach someone who's never messaged
# the bot). Create/approve it in WhatsApp Manager -> Message templates.
# META_WELCOME_TEMPLATE_NAME=
# META_WELCOME_TEMPLATE_LANG=en_US

# Onboarding candidate directory (optional — bot personalises replies if set)
# Option 1: private Google Sheet via service account
# ONBOARDING_SHEET_ID=
# GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
# Option 2: published CSV URL (testing only)
# ONBOARDING_SHEET_CSV=
# Option 3: local CSV file
# ONBOARDING_SHEET_FILE=data/onboarding_log.csv

# Google Drive knowledge-base sync (optional — knowledge.md stays local-only
# and unmodified until a service account is configured here; can reuse the
# same GOOGLE_SERVICE_ACCOUNT_FILE as the candidate directory above, as long
# as that service account has been shared "Viewer" on the Drive folder)
# GOOGLE_SERVICE_ACCOUNT_FILE=data/service_account.json
# GOOGLE_DRIVE_FOLDER_ID=1aGaZa6N2i2CbZ1xY7k9AAzUO9b3hy4Ju
# GOOGLE_DRIVE_SYNC_TTL_HOURS=1

# Reporting (reports.py, invoked by cron — see LOCAL_SETUP.md for the cron
# entries). Dormant until SMTP is configured: --daily emails unanswered
# questions from that day, --weekly emails questions asked multiple times
# (clustered by meaning, not just exact wording) over the trailing 7 days.
# Works with Gmail (smtp.gmail.com, port 587, an App Password — not your
# regular password), Office365, or any standard SMTP relay.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_USE_SSL=false
REPORT_EMAIL_TO=anjali.gupta@recykal.com
# REPEAT_CLUSTER_THRESHOLD=0.83
