# Local Development Configuration
# Copy this to .env and fill in your values

# Project directories (local paths)
PROJECT_DIR=/home/user/chatbot-local
UPLOADS_DIR=${PROJECT_DIR}/uploads
DATABASE_PATH=${PROJECT_DIR}/chatbot.db
KNOWLEDGE_FILE=${PROJECT_DIR}/knowledge.md

# Server settings
HOST=0.0.0.0
PORT=8002

# Google Drive (optional, for production)
USE_GOOGLE_DRIVE=false
GOOGLE_CREDENTIALS_PATH=${PROJECT_DIR}/google-credentials.json
GOOGLE_FOLDER_ID=

# Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
